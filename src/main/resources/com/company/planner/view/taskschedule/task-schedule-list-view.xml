<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://taskScheduleListView.title"
      focusComponent="taskSchedulesDataGrid">
    <data>
        <collection id="taskSchedulesDc"
                    class="com.company.planner.entity.TaskSchedule">
            <fetchPlan extends="_base">
                <property name="task" fetchPlan="_instance_name">
                    <property name="deadline"/>
                    <property name="category" fetchPlan="_base"/>
                </property>
            </fetchPlan>
            <loader id="taskSchedulesDl" readOnly="true">
                <query>
                    <![CDATA[select e from plan_TaskSchedule e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="taskSchedulesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="taskSchedulesDataGrid.createAction"/>
                <button id="editButton" action="taskSchedulesDataGrid.editAction"/>
                <button id="removeButton" action="taskSchedulesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="taskSchedulesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="taskSchedulesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="taskSchedulesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="task"/>
                <column property="planDate"/>
                <column property="isCompleted"/>
                <column property="orderNum"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
