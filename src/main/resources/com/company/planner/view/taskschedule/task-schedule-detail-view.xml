<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://taskScheduleDetailView.title"
      focusComponent="form">
    <data>
        <instance id="taskScheduleDc"
                  class="com.company.planner.entity.TaskSchedule">
            <fetchPlan extends="_base">
                <property name="task" fetchPlan="_instance_name">
                    <property name="deadline"/>
                    <property name="category" fetchPlan="_base"/>
                </property>
            </fetchPlan>
            <loader id="taskScheduleDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="taskScheduleDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityPicker id="taskField" property="task">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <datePicker id="planDateField" property="planDate"/>
            <checkbox id="isCompletedField" property="isCompleted"/>
            <textField id="orderNumField" property="orderNum"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
